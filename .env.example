# Copy to .env and fill in. Never commit .env.
CLICKHOUSE_PASSWORD=
PUBLIC_HOSTS=cristinadelisle.xyz,www.cristinadelisle.xyz
# true only when the origin is reachable exclusively through Cloudflare
TRUST_CLOUDFLARE=false
# true once the site is served over HTTPS
HSTS=false
# Optional
CONTACT_WEBHOOK_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
CLOUDFLARE_TUNNEL_TOKEN=

# Behind a reverse proxy that connects over the network (e.g. cjdns):
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# TRUSTED_PROXIES=<address of the proxy machine>

# On a VPS with its own public IP (Caddy handles HTTPS):
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
# SITE_DOMAIN=cristinadelisle.xyz
# ACME_EMAIL=hello@cristinadelisle.xyz

# Email each contact message to the owner (e.g. Gmail with an app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=<app password>
# CONTACT_NOTIFY_TO=you@gmail.com
